# ============================================================================
# wh40k-rag environment template
# ----------------------------------------------------------------------------
# Copy this file to ".env" in the project root and fill in real values.
# The .env file is gitignored — never commit it.
# ============================================================================

# --- Required ---------------------------------------------------------------

# Your Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here

# Absolute path to the folder containing your Warhammer 40K PDFs.
# Used by both ingest.py (reads source PDFs) and main.py (serves them
# inline to the UI when a citation is clicked).
PDF_FOLDER=C:\Personal Projects\warhammer_40k_pdfs

# --- Optional (sensible defaults are baked in) ------------------------------

# Where the ChromaDB persistent store lives on disk.
CHROMA_PATH=C:\Projects\wh40k-app\chroma_db

# ChromaDB collection name. You shouldn't usually need to change this.
COLLECTION_NAME=warhammer40k

# Ollama embedding API endpoint and model. The launcher (launch.bat)
# auto-starts Ollama and pulls this model if missing.
OLLAMA_URL=http://127.0.0.1:11434/api/embeddings
OLLAMA_MODEL=nomic-embed-text

# Anthropic model used for both filter extraction and answer generation.
ANTHROPIC_MODEL=claude-sonnet-4-6
